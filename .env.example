# ─── Example environment variables for CryptoSentinel ──────────────────
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# NEVER commit your real .env file. The .gitignore blocks .env*.

# ─── Database ────────────────────────────────────────────────────────
# SQLite path. MUST be on persistent storage (NOT /tmp — /tmp is wiped on reboot).
# Docker: /data/cryptosentinel.db  (mount /data as a volume)
# PM2/VPS: /var/lib/cryptosentinel/cryptosentinel.db
DATABASE_URL=file:/data/cryptosentinel.db

# ─── AI Provider (OpenRouter) ─────────────────────────────────────────
# Required for AI analysis. Get a key at https://openrouter.ai/keys
# Keys start with `sk-or-v1-` and are 30+ characters.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ─── Optional: GitHub Token (for higher rate limits + private repos) ──
# Default is 60 req/hour unauthenticated. With a token: 5,000 req/hour.
GITHUB_TOKEN=

# ─── Optional: Authentication ──────────────────────────────────────────
# If set, all /api/* routes (except /api/login and /api/health) require
# this token either:
#   - As a cookie: cryptosentinel-token=<value>
#   - As Authorization: Bearer <value> header
# If empty/missing, the API is open (suitable for localhost dev only).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRYPTOSENTINEL_AUTH_TOKEN=

# ─── Optional: Production domain (used as HTTP-Referer to OpenRouter) ──
# Defaults to localhost if not set.
CRYPTOSENTINEL_APP_URL=https://cryptosentinel.example.com

# ─── Runtime tuning ───────────────────────────────────────────────────
NODE_OPTIONS=--max-old-space-size=2048
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
